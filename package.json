{
  "name": "legacy-enterprises-web",
  "private": true,
  "version": "1.0.0",
  "description": "Statické weby Legacy Enterprises (kořen) a Legent AI (/legent). Bez build kroku za běhu – HTML/CSS/JS se servíruje tak, jak je.",
  "type": "module",
  "scripts": {
    "fonts": "node tools/fonts.mjs",
    "build": "node tools/build.mjs && node tools/seo.mjs",
    "serve": "node tools/serve.mjs",
    "validate": "html-validate \"**/*.html\"",
    "test": "node tools/build.mjs --check && npm run validate && node tests/run.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "axe-core": "4.14.1",
    "html-validate": "11.21.1"
  }
}
